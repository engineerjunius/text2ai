PORT=4000
# Base connection string without a database name; "/Text2AI" is appended in config/mongodb.js
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
JWT_SECRET=replace-with-a-long-random-string
CLIPDROP_API=your-clipdrop-api-key

# Optional: free images a visitor can generate before signing up (default 2)
GUEST_FREE_LIMIT=2
# Optional: set to 1 when deployed behind a proxy so visitor IPs are read correctly
# TRUST_PROXY=1
