PORT=4000

# Main image provider: Cloudflare Workers AI (free, ~170 images/day, no card needed)
# Account ID: dashboard > Workers & Pages. Token: My Profile > API Tokens > "Workers AI" template
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token

# Optional fallback provider: free key from https://enter.pollinations.ai
# POLLINATIONS_API_KEY=sk_...

# Optional: free images per visitor per day (default 20) and for everyone combined
# per day (default 160, kept under Cloudflare's free quota)
DAILY_LIMIT_PER_IP=20
GLOBAL_DAILY_LIMIT=160

# Optional: set to 1 when deployed behind a proxy so visitor IPs are read correctly
# TRUST_PROXY=1
